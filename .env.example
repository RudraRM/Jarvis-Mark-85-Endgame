# NVIDIA Free API Key (for OpenAI Whisper and TTS access)
# Get your free key from: https://build.nvidia.com/
NVIDIA_API_KEY=Paste Api Key Here

# Speech-to-Text Configuration (using NVIDIA endpoint for OpenAI Whisper)
NVIDIA_ASR_URL=https://ai.nvidia.com/api/v1/audio/transcriptions
ASR_MODEL=whisper-1

# Text-to-Speech Configuration (using NVIDIA endpoint for OpenAI TTS)
NVIDIA_TTS_URL=https://ai.nvidia.com/api/v1/audio/speech
# Voice options: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=alloy

# Optional: LLM Configuration (for agent responses)
# Only needed if you want natural language responses from DiffusionGemma
# Leave as-is for simulated/local fallback mode
NVIDIA_LLM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_LLM_MODEL=google/diffusiongemma-26b-a4b-it
