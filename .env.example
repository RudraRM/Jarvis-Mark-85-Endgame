# OpenAI API Key for Speech-to-Text (Whisper) and Text-to-Speech
# Get your key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-Paste-Api-Key-Here

# Speech-to-Text Configuration
# Model: whisper-1 (OpenAI's Whisper Large v3)
ASR_MODEL=whisper-1

# Text-to-Speech Configuration
# Voice options: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=alloy

# Optional: LLM Configuration (for agent responses)
# Only needed if you want natural language responses from DiffusionGemma
# Leave as-is for simulated/local fallback mode
NVIDIA_API_KEY=Paste-Api-Key-Here
NVIDIA_LLM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_LLM_MODEL=google/diffusiongemma-26b-a4b-it
