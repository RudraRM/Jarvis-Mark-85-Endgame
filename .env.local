# NVIDIA NIM API key (https://build.nvidia.com) — used by both API routes.
NVIDIA_API_KEY=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

# Parakeet CTC 1.1B ASR endpoint. Point at a hosted NIM node or your local docker NIM.
NVIDIA_ASR_URL=https://integrate.api.nvidia.com/v1/audio/transcriptions
NVIDIA_ASR_MODEL=nvidia/parakeet-ctc-1.1b-asr

# DiffusionGemma chat-completions endpoint used by the Hermes Web Fish Agent.
NVIDIA_LLM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_LLM_MODEL=google/diffusiongemma-26b-a4b-it
