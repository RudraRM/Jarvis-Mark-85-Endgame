# OpenAI API Key for Whisper v3 (Speech-to-Text) and LLM
OPENAI_API_KEY=Paste Api Key Here

# Speech-to-Text Configuration
ASR_MODEL=whisper-1
TTS_VOICE=alloy

# LLM Configuration (for agent responses)
NVIDIA_API_KEY=Paste Api Key Here
NVIDIA_LLM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_LLM_MODEL=google/diffusiongemma-26b-a4b-it
